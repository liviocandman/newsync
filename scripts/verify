#!/usr/bin/env python3
"""Single verification gate for Linux/WSL and CI. Never loads .env."""

import argparse
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
import uuid
from datetime import UTC, datetime
from pathlib import Path
from xml.etree import ElementTree as ET

import delivery
import reports
from quality_tools import TOOLS

ROOT = Path(__file__).resolve().parent.parent


def main(argv=()):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--mode", choices=("ci", "full"), default="full")
    parser.add_argument(
        "--prepare-browser",
        action="store_true",
        help="Explicitly install Chromium system libraries (used by hosted CI).",
    )
    options = parser.parse_args(argv)
    full = options.mode == "full"
    # Do not inherit JDBC, Spring, tokens, or debugging options from the personal installation.
    env = {
        key: value
        for key, value in os.environ.items()
        if re.fullmatch(
            r"PATH|HOME|USER|JAVA_HOME|TMPDIR|CI|LANG|LC_.*|LD_LIBRARY_PATH|PLAYWRIGHT_.*|"
            r"DOCKER_.*|TESTCONTAINERS_HOST_OVERRIDE|NODE_EXTRA_CA_CERTS|MAVEN_USER_HOME|npm_config_cache|NEWS_TOOLS_DIR",
            key,
        )
    }
    if os.environ.get("NEWS_LEGACY_JAR"):
        env["NEWS_LEGACY_JAR"] = str(Path(os.environ["NEWS_LEGACY_JAR"]).resolve())
    run_id = os.environ.get("NEWS_E2E_RUN_ID", str(uuid.uuid4()))
    reports.require(
        re.fullmatch(r"[a-zA-Z0-9-]{1,100}", run_id), "Identificação do gate inválida"
    )
    env["NEWS_E2E_RUN_ID"] = run_id
    artifacts = ROOT / "artifacts"
    artifacts.mkdir(exist_ok=True)
    with (artifacts / ".verify.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError(
                "Outro gate usa este checkout; aguarde ou use checkout isolado."
            ) from None
        output = artifacts / (datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ-") + run_id)
        output.mkdir()
        summary = {
            "runId": run_id,
            "mode": options.mode,
            "acceptance": "distribution" if full else "continuous-integration",
            "status": "running",
            "stages": [],
            "results": {},
            "toolVersions": {"python": sys.version.split()[0]},
        }
        active = None
        e2e_attempted = False
        installation_attempted = False

        def save():
            (output / "summary.json").write_text(
                json.dumps(summary, indent=2, ensure_ascii=False) + "\n"
            )

        def stop():
            if active is None:
                return
            try:
                os.killpg(active.pid, signal.SIGTERM)
                active.wait(timeout=20)
            except ProcessLookupError:
                pass
            except subprocess.TimeoutExpired:
                os.killpg(active.pid, signal.SIGKILL)
                active.wait(timeout=10)

        def run(name, command, cwd=ROOT, timeout=1800, scope=None, report_paths=()):
            nonlocal active
            print(f"[{name}] {' '.join(command)}", flush=True)
            started = time.monotonic()
            code = 1
            with (output / f"{name}.log").open("w") as log:
                try:
                    active = subprocess.Popen(
                        command,
                        cwd=cwd,
                        env=env,
                        stdout=log,
                        stderr=subprocess.STDOUT,
                        start_new_session=True,
                    )
                    code = active.wait(timeout=timeout)
                except subprocess.TimeoutExpired:
                    code = 124
                    stop()
                except KeyboardInterrupt:
                    code = 130
                    stop()
                    raise
                finally:
                    active = None
                    summary["stages"].append(
                        {
                            "name": name,
                            "command": command,
                            "exitCode": code,
                            "seconds": round(time.monotonic() - started, 2),
                            "cwd": str(cwd.relative_to(ROOT)),
                            "scope": scope or command[1:],
                            "toolVersions": dict(summary["toolVersions"]),
                            "reports": [
                                {
                                    "path": str(path.relative_to(output)),
                                    "discovered": path.is_file(),
                                }
                                for path in (output / f"{name}.log", *report_paths)
                            ],
                        }
                    )
                    save()
            if code and name == "environment":
                # Prerequisite logs contain tool versions and diagnostics, never personal settings.
                print((output / f"{name}.log").read_text()[-8192:], file=sys.stderr)
            reports.require(
                code == 0,
                f"Etapa {name} falhou (exit {code}); consulte {output / (name + '.log')}",
            )
            for path in report_paths:
                reports.require(path.is_file(), f"Required report missing: {path}")

        def archive_backend(profile):
            destination = output / profile
            destination.mkdir()
            for runner in ("surefire", "failsafe"):
                source = ROOT / "backend/target" / f"{runner}-reports"
                target = destination / source.name
                if source.exists():
                    shutil.copytree(source, target)
                    # JVM properties may contain external options; they are not test evidence.
                    for path in target.glob("TEST-*.xml"):
                        tree = ET.parse(path)
                        properties = tree.getroot().find("properties")
                        if properties is not None:
                            tree.getroot().remove(properties)
                        tree.write(path, encoding="utf-8", xml_declaration=True)
            t20 = ROOT / "backend/target/t20-result.json"
            if t20.exists():
                shutil.copy2(t20, destination / t20.name)
            scanner = ROOT / "backend/target/spotbugsXml.xml"
            if scanner.exists():
                shutil.copy2(scanner, destination / scanner.name)
            for name in ("coverage-unit", "coverage-integration"):
                source = ROOT / "backend/target" / name
                if source.exists():
                    shutil.copytree(source, destination / name)
            for name in (
                "checkstyle-result.xml",
                "checkstyle-metrics.xml",
                "jacoco-unit.exec",
                "jacoco-integration.exec",
            ):
                source = ROOT / "backend/target" / name
                if source.exists():
                    shutil.copy2(source, destination / name)
            return destination

        def interrupted(_signal, _frame):
            raise KeyboardInterrupt

        previous = {
            sig: signal.signal(sig, interrupted)
            for sig in (signal.SIGINT, signal.SIGTERM)
        }
        print(f"Relatórios desta execução: {output}", flush=True)
        try:
            pom = ET.parse(ROOT / "backend/pom.xml").getroot()
            for plugin in pom.findall(".//{*}plugin") + pom.findall(".//{*}dependency"):
                artifact = plugin.findtext("{*}artifactId")
                version = plugin.findtext("{*}version")
                if version:
                    summary["toolVersions"]["backend/" + artifact] = version
            summary["toolVersions"]["google-java-format"] = pom.findtext(
                ".//{*}googleJavaFormat/{*}version"
            )
            summary["toolVersions"]["gitleaks"] = "8.30.1"
            # Provision checks for a fresh checkout without rewriting source files.
            run(
                "environment",
                [
                    "python3",
                    str(ROOT / "scripts/verify_environment.py"),
                    str(output / "environment.json"),
                    *(["--distribution"] if full else []),
                ],
                timeout=240,
                report_paths=(output / "environment.json",),
            )
            summary["toolVersions"].update(
                json.loads((output / "environment.json").read_text())
            )
            run(
                "delivery",
                [
                    "python3",
                    "scripts/delivery.py",
                    *(["--checkout"] if os.environ.get("CI") else []),
                ],
                scope=["config/delivery-files.json"],
            )
            run(
                "npm-ci-tools",
                ["npm", "ci", "--no-audit", "--no-fund"],
                ROOT / "tools/quality",
                600,
            )
            run(
                "npm-ci",
                ["npm", "ci", "--no-audit", "--no-fund"],
                ROOT / "frontend",
                600,
            )
            for directory in ("frontend", "tools/quality"):
                declared = json.loads((ROOT / directory / "package.json").read_text())
                for name, expected in declared["devDependencies"].items():
                    actual = json.loads(
                        (
                            ROOT / directory / "node_modules" / name / "package.json"
                        ).read_text()
                    )["version"]
                    reports.require(
                        actual == expected,
                        f"Installed tool version differs: {directory}/{name}",
                    )
                    summary["toolVersions"][directory + "/" + name] = actual
            for tool in ("ruff", "trivy"):
                run(
                    "tool-" + tool,
                    ["python3", "scripts/quality_tools.py", tool, "--version"],
                    timeout=600,
                )
                summary["toolVersions"][tool] = TOOLS[tool]["version"]
            run(
                "format-files",
                ["python3", "scripts/format_check.py"],
                scope=delivery.files(),
            )
            run(
                "format-python",
                [
                    "python3",
                    "scripts/quality_tools.py",
                    "ruff",
                    "format",
                    "--check",
                    ".",
                ],
            )
            run(
                "lint-python",
                ["python3", "scripts/quality_tools.py", "ruff", "check", "."],
            )
            run("lint-frontend", ["npm", "--prefix", "tools/quality", "run", "lint"])
            # Maven validate checks Java formatting/conventions as part of the actual builds.
            if full:
                run(
                    "quality-probes",
                    [
                        "python3",
                        "scripts/quality_probes.py",
                        "--output",
                        str(output / "quality-probes.json"),
                    ],
                    timeout=600,
                    report_paths=(output / "quality-probes.json",),
                )
            run("link-tests", ["node", "--test", "scripts/check_links.test.mjs"])
            run(
                "links",
                ["node", "scripts/check_links.mjs"],
                scope=[name for name in delivery.files() if name.endswith(".md")],
            )
            if full:
                run(
                    "source-snapshot",
                    [
                        "python3",
                        "scripts/delivery.py",
                        "--snapshot",
                        str(output / "source-snapshot"),
                    ],
                )
                run(
                    "snapshot-links",
                    [
                        "node",
                        "scripts/check_links.mjs",
                        str(output / "source-snapshot"),
                    ],
                )
            run(
                "gate-tests",
                [
                    "python3",
                    "-m",
                    "unittest",
                    "discover",
                    "-s",
                    "scripts",
                    "-p",
                    "test_*.py",
                ],
            )
            run(
                "secrets",
                [
                    "python3",
                    str(ROOT / "scripts/scan_secrets.py"),
                    str(output / "gitleaks.json"),
                ],
                timeout=300,
            )
            reports.require(
                json.loads((output / "gitleaks.json").read_text()) == [],
                "Varredura de segredos não aprovada",
            )
            summary["results"]["gitleaks"] = {"version": "8.30.1", "findings": 0}
            run(
                "audit-npm",
                [
                    "python3",
                    "scripts/dependency_audit.py",
                    "--npm",
                    "--output",
                    str(output / "audit-npm"),
                ],
                timeout=1000,
                report_paths=(output / "audit-npm/decision.json",),
            )
            summary["results"]["auditNpm"] = json.loads(
                (output / "audit-npm/decision.json").read_text()
            )
            for profile in ("normal", "demo"):
                command = (
                    ["sh", "./mvnw", "-B", "-ntp"]
                    + (["-Pdemo"] if profile == "demo" else [])
                    + (
                        ["-DskipTests", "clean", "package"]
                        if profile == "demo" and not full
                        else ["clean", "verify"]
                    )
                )
                try:
                    run("backend-" + profile, command, ROOT / "backend")
                finally:
                    destination = archive_backend(profile)
                if full or profile == "normal":
                    summary["results"][profile] = reports.backend(destination)
                    summary["results"][profile]["coverage"] = reports.coverage_java(
                        destination
                    )
                    t20 = json.loads((destination / "t20-result.json").read_text())
                    reports.require(
                        t20.get("status") == "passed" and t20.get("toolExits"),
                        "Prova T-20 ausente/incompleta",
                    )
                    summary["results"][profile]["backupRestore"] = t20
                    reports.require(
                        (destination / "spotbugsXml.xml").is_file(),
                        "Relatório SpotBugs/FindSecBugs ausente",
                    )
                    summary["results"][profile]["staticAnalysis"] = (
                        "SpotBugs/FindSecBugs passed"
                    )
                else:
                    summary["results"][profile] = {
                        "validation": "packaged UI, inventory and browser; Java suites executed in normal build",
                    }
                shutil.copy2(ROOT / "backend/target/news.jar", destination / "news.jar")
                summary["results"][profile]["jar"] = reports.jar(
                    destination / "news.jar", destination, profile
                )
                save()
            audit_profiles = ("normal", "demo") if full else ("normal",)
            run(
                "audit-jars",
                [
                    "python3",
                    "scripts/dependency_audit.py",
                    *[
                        argument
                        for profile in audit_profiles
                        for argument in (
                            "--jar",
                            profile + "=" + str(output / profile / "news.jar"),
                        )
                    ],
                    "--output",
                    str(output / "audit-jars"),
                ],
                timeout=1800,
                report_paths=(output / "audit-jars/decision.json",),
            )
            summary["results"]["auditJars"] = json.loads(
                (output / "audit-jars/decision.json").read_text()
            )
            audited = summary["results"]["auditJars"]["targets"]
            reports.require(
                {item["target"] for item in audited}
                == {"jar:" + profile for profile in audit_profiles},
                "Final JAR audit targets missing",
            )
            for item in audited:
                profile = item["target"].split(":")[1]
                reports.require(
                    item["sha256"] == summary["results"][profile]["jar"]["sha256"],
                    "Audited JAR differs from tested artifact",
                )
            env["NEWS_COVERAGE_DIR"] = str(output / "coverage-frontend")
            for name, command in (
                ("typecheck", ["npm", "run", "typecheck"]),
                (
                    "vitest",
                    [
                        "npm",
                        "run",
                        "test:coverage",
                        "--",
                        "--reporter=default",
                        "--reporter=json",
                        f"--outputFile={output / 'vitest.json'}",
                    ],
                ),
                (
                    "chromium",
                    [
                        "npm",
                        "exec",
                        "--",
                        "playwright",
                        "install",
                        *(["--with-deps"] if options.prepare_browser else []),
                        "chromium",
                    ],
                ),
            ):
                run(name, command, ROOT / "frontend", 600)
                if name == "vitest":
                    summary["results"][name] = reports.vitest(output / "vitest.json")
                    summary["results"][name]["coverage"] = reports.coverage_frontend(
                        output / "coverage-frontend", ROOT / "frontend/src"
                    )
                    save()
            if full:
                run(
                    "metrics",
                    ["node", "scripts/metrics.mjs", str(output / "metrics")],
                    report_paths=(
                        output / "metrics/complexity.json",
                        output / "metrics/jscpd-report.json",
                        output / "metrics/summary.json",
                    ),
                )
                summary["results"]["metrics"] = json.loads(
                    (output / "metrics/summary.json").read_text()
                )
            for profile in ("normal", "demo"):
                env["NEWS_" + profile.upper() + "_SHA256"] = summary["results"][
                    profile
                ]["jar"]["sha256"]
                env["NEWS_" + profile.upper() + "_JAR"] = str(
                    output / profile / "news.jar"
                )
            shutil.rmtree(ROOT / "frontend/test-results", ignore_errors=True)
            e2e_attempted = True
            run("playwright", ["npm", "run", "test:e2e"], ROOT / "frontend", 900)
            summary["results"]["playwright"] = {
                profile: reports.playwright(
                    ROOT / ("frontend/test-results/playwright-" + profile + ".json"),
                    profile,
                )
                for profile in ("normal", "demo", "packaged-normal", "packaged-demo")
            }
            processes = json.loads(
                (ROOT / "frontend/test-results/processes.json").read_text()
            )
            reports.require(
                processes
                == {"runId": run_id, "viteExited": True, "playwrightExited": True},
                "Processos E2E não encerraram",
            )
            summary["results"]["processes"] = processes
            if full:
                revision = (
                    "snapshot-"
                    + hashlib.sha256(delivery.hashes().encode()).hexdigest()[:24]
                )
                run(
                    "image",
                    [
                        "python3",
                        str(ROOT / "scripts/build_image.py"),
                        "--jar",
                        env["NEWS_NORMAL_JAR"],
                        "--sha256",
                        env["NEWS_NORMAL_SHA256"],
                        "--revision",
                        revision,
                        "--output",
                        str(output / "distribution"),
                        "--save",
                    ],
                    timeout=1200,
                )
                summary["results"]["image"] = json.loads(
                    (output / "distribution/image.json").read_text()
                )
                run(
                    "audit-images",
                    [
                        "python3",
                        "scripts/dependency_audit.py",
                        "--images",
                        str(output / "distribution/image.json"),
                        "--output",
                        str(output / "audit-images"),
                    ],
                    timeout=1800,
                    report_paths=(output / "audit-images/decision.json",),
                )
                summary["results"]["auditImages"] = json.loads(
                    (output / "audit-images/decision.json").read_text()
                )
                for name in ("install-guide.md", "backup-guide.md", "backup.py"):
                    reports.require(
                        (output / "distribution" / name).read_bytes()
                        == (ROOT / "scripts" / name).read_bytes(),
                        f"Stale distributed helper/guide: {name}",
                    )
                installation_attempted = True
                run(
                    "installation",
                    [
                        "python3",
                        str(ROOT / "scripts/installation_test.py"),
                        "--image",
                        str(output / "distribution/image.json"),
                        "--jar",
                        env["NEWS_NORMAL_JAR"],
                        "--output",
                        str(output / "installation"),
                    ]
                    + (
                        ["--legacy-jar", env["NEWS_LEGACY_JAR"]]
                        if "NEWS_LEGACY_JAR" in env
                        else []
                    ),
                    timeout=1200,
                )
                t19 = json.loads((output / "installation/t19.json").read_text())
                required_t19 = {
                    "clean-install",
                    "public-feed-without-product-bypass",
                    "image-browser",
                    "restart-csrf",
                    "live-wrong-container-rejected",
                    "stopped-container-backup",
                    "identified-upgrade",
                    "migration-failure-not-ready",
                    "packaged-helper-restore-new-cluster",
                    "previous-image-recovery",
                    "no-collection-during-recovery",
                    "deliberate-resume-recovered-installation",
                }
                reports.require(
                    t19.get("status") == "passed"
                    and t19.get("cleanup") is True
                    and required_t19 <= set(t19.get("scenarios", []))
                    and t19.get("cacheUpdate", {}).get("status") == "passed"
                    and set(t19.get("configurationNegatives", []))
                    == {
                        "missing-secret",
                        "unreadable-secret",
                        "demo-container",
                        "unknown-deployment",
                        "non-loopback-origin",
                    },
                    "T-19 ausente/incompleto",
                )
                summary["results"]["installation"] = t19
            summary["status"] = "passed"
        except KeyboardInterrupt:
            summary.update(status="cancelled", error="Execução interrompida")
            return_code = 130
        except (
            RuntimeError,
            OSError,
            ValueError,
            KeyError,
            subprocess.SubprocessError,
            ET.ParseError,
        ) as error:
            summary.update(status="failed", error=str(error))
            print(str(error), file=sys.stderr)
            return_code = 1
        else:
            return_code = 0
        finally:
            stop()
            # Cleanup has its own deadline and must complete after the first signal.
            for sig in previous:
                signal.signal(sig, signal.SIG_IGN)
            # Second defense against worker failure or cancellation; filter by this run UUID.
            try:
                if installation_attempted:
                    run(
                        "cleanup-installation",
                        [
                            "python3",
                            str(ROOT / "scripts/installation_test.py"),
                            "--cleanup",
                            "--output",
                            str(output / "installation"),
                        ],
                        timeout=90,
                    )
                if e2e_attempted:
                    run(
                        "cleanup",
                        ["node", str(ROOT / "frontend/scripts/e2e.mjs"), "--cleanup"],
                        timeout=90,
                    )
            except (RuntimeError, OSError) as error:
                summary.update(status="failed", cleanupError=str(error))
                return_code = return_code or 1
            for sig, handler in previous.items():
                signal.signal(sig, handler)
            source = ROOT / "frontend/test-results"
            if source.exists():
                if e2e_attempted:
                    shutil.copytree(source, output / "e2e")
                elif (source / "cleanup.json").exists():
                    (output / "e2e").mkdir()
                    shutil.copy2(source / "cleanup.json", output / "e2e/cleanup.json")
            try:
                manifest = delivery.hashes()
            except (RuntimeError, OSError, ValueError) as error:
                summary.update(status="failed", manifestError=str(error))
                return_code = return_code or 1
                manifest = ""
            (output / "implementation.sha256").write_text(manifest)
            summary["implementationSha256"] = hashlib.sha256(
                manifest.encode()
            ).hexdigest()
            save()
            print(f"Gate: {summary['status']}. Evidências: {output}", flush=True)
        return return_code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
